{
    "workbench.iconTheme": "material-icon-theme",
    "workbench.colorTheme": "One Dark Pro",
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "cmake.options.statusBarVisibility": "compact",
    "makefile.configureOnOpen": true,
    "redhat.telemetry.enabled": false,
    "workbench.editor.enablePreview": false,
    "editor.wordWrap": "on",
    "C_Cpp.vcFormat.indent.preprocessor": "oneLeft",
    "C_Cpp.vcFormat.newLine.beforeElse": false,
    "C_Cpp.vcFormat.newLine.closeBraceSameLine.emptyFunction": true,
    "C_Cpp.vcFormat.newLine.closeBraceSameLine.emptyType": true,
    "C_Cpp.vcFormat.space.pointerReferenceAlignment": "right",
    "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: LLVM, UseTab: Never, IndentWidth: 4, TabWidth: 4, BreakBeforeBraces: Attach, AllowShortIfStatementsOnASingleLine: false, IndentCaseLabels: false, ColumnLimit: 0, AccessModifierOffset: -4, NamespaceIndentation: All, FixNamespaceComments: false }",
    "telemetry.telemetryLevel": "crash",
    "docker.lsp.telemetry": "off",
    "vim.incsearch": true,
    "vim.hlsearch": true,
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["Q"],
            "after": ["@", "q"]
        },
        {
            "before": ["<Esc>"],
            "after": [":nohl<CR>"]
        }
    ],
    "vim.leader": "<Space>"
}