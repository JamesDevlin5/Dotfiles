}

gr() {
    local ROOT
    ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
        echo -e "\033[1;31mNot inside a Git Repository...\033[0m"
        return 1
    }
    cd "${ROOT}" || return
}

freq() {
    cut -f1 -d" " "${HISTFILE}" | sort | uniq -c | sort -nr | head -n 30
}

tre() {
    broot -c :pt "$@"
}

search() {
    fd * | fzf --prompt 'All> ' \
        --header 'CTRL-D: Directories / CTRL-F: Files / CTRL-A: All' \
        --bind 'ctrl-d:change-prompt(Directories> )+reload(find * -type d)' \
        --bind 'ctrl-f:change-prompt(Files> )+reload(find * -type f)' \
        --bind 'ctrl-a:change-prompt(All> )+reload(find *)'
}

esearch() {
    nvim "$(search)"
}

# Go to Git repository root
gr() {
    local ROOT
    ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
        echo -e "\033[1;31mNot inside a Git repository\033[0m"
        return 1
    }

    cd "${ROOT}" || return
}

# Markdown View {{{

mdview() {
    infile="$1"
    tmpfile="$(mktemp)"
    mv "$tmpfile" "$tmpfile.html"
    pandoc -i "$infile" -o "$tmpfile.html" -t html -s --toc --quiet
    # xdg-open "$tmpfile.html" &
    firefox --new-tab "$tmpfile.html"
}

zstyle ':completion:*:complete:mdview:*' file-patterns '
  *(D-/):local-directories:"local directory"
  *.md(D-^/):md-file:"markdown file"
'

