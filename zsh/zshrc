del-br() {
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        echo "Not in a git repo..."
        return 1
    fi

    NEW_BRANCH="${1:-main}"

    CURRENT_BRANCH="$(git branch --show-current)"

    git checkout "${NEW_BRANCH}"

    git pull --ff-only origin "${NEW_BRANCH}"

    git branch -D "${CURRENT_BRANCH}"
}

