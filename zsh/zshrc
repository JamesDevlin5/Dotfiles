zstyle ':completion:*' completer _complete _match _list _ignored _correct _approximate _prefix
zstyle ':completion:*' matcher-list 'm:{-_}={_-}' '+m:{a-z}={A-Z}'

zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' verbose yes
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.local/share/zsh/zcompcache
zstyle ':completion:*' squeeze-slashes true
zstyle ':completion:*:(ls|exa|cd|rmdir):*' list-dirs-first true
zstyle ':completion:*' insert-unambiguous true
zstyle ':completion:*:correct:*' max-errors 4 not-numeric
zstyle ':completion:*:correct:*' max-errors 3 numeric
zstyle ':completion:*' menu select=2
zstyle ':completion:*' group-name ''
zstyle ':completion:*:default' select-prompt %SScrolling active: current selection at %p%s
zstyle -e ':completion:*:default' list-colors "reply=("${PREFIX:+=(#bi)($PREFIX:t)(?)*==34=34}:${(s.:.)LS_COLORS}")"
zstyle ':completion:*:descriptions' format "[%F{green} %d %f]"
zstyle ':completion:*:corrections' format "%F{yellow} ~ %d (errors: %F{red}%e%F{yellow}) ~%f"
zstyle ':completion:*:messages' format "%F{blue} +  %d  +%f"
zstyle ':completion:*:warnings' format "%F{red} --  No Matches For: %d  --%f"
zstyle ':completion:*:manuals' separate-sections true
zstyle ':completion:*:*:*:hosts' ignored-patterns \
    localhost loopback ip6-localhost ip6-loopback localhost6 localhost6.localdomain6 localhost.localdomain
zstyle ':completion:*:*:(cd|nvim|ls):*:*' ignored-patterns '.idea|.git|__pycache__'
zstyle ':completion:*:*:kill:*' menu yes select
zstyle ':completion:*:*:kill:*' force-list always
zstyle ':completion:*:(rm|kill|diff|cp):*' ignore-line yes
zstyle ':completion:*:functions' ignored-patterns '_*'

zstyle ':completion:*:*:(cp|bat):*' file-sort modification reverse
zstyle ':completion:*:cd:*' tag-order local-directories directory-stack path-directories
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:bat:*' tag-order files subcommands
zstyle ':completion:complete:*:options' sort false

compdef _dirs exa fd

zstyle ':completion:*:complete:flex:*' file-patterns '
*(D-/):local-directories:"local directory"
*.(l|lex|flex):lex-file:"lex file"
'
zstyle ':completion:*:complete:(yacc|bison):*' file-patterns '
