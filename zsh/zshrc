'

zle-keymap-select () {
    if [ $KEYMAP = vicmd ]; then
        printf "\033[2 q"
    else
        printf "\033[6 q"
    fi
}
zle-line-init() {
    zle -K viins
    printf "\033[6 q"
}
zle -N zle-keymap-select
zle -N zle-line-init

